# Existing app API behavior:
# Leave VITE_API_URL blank for same-origin Express API requests.
VITE_API_URL=

# Medusa Store API connection.
# Local Medusa defaults to http://localhost:9000.
VITE_MEDUSA_BACKEND_URL=http://localhost:9000

# Create this in the Medusa Admin dashboard under Settings / Publishable API Keys.
VITE_MEDUSA_PUBLISHABLE_KEY=pk_replace_with_medusa_publishable_key
