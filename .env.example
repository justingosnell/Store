# Existing Express backend service.
NODE_ENV=development
PORT=3000

# Neon database for the custom website.
DATABASE_URL=

# Public frontend URLs allowed to call the Express API.
# In production, set this to your Render service URL.
FRONTEND_URL=http://localhost:3000
FRONTEND_URLS=http://localhost:3000,http://localhost:5173

# Admin/session settings for the existing Express backend.
SESSION_SECRET=replace-with-a-long-random-value
SESSION_COOKIE_NAME=connect.sid
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=change-this-password
# Set to true for one deploy only to reset the existing admin password and unlock the account.
RESET_ADMIN_PASSWORD=false

# Cloudinary image uploads for the existing admin/media library.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# Google Search Console import for /admin Analytics.
# Create these in Google Cloud Console OAuth credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/search-console/callback
